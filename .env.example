# API base path. With the dev proxy (default) this stays relative.
VITE_API_BASE_URL=/api/v1
# Origin for Socket.IO. Empty = same origin (works with the dev proxy).
VITE_SOCKET_URL=

# Minutes without input before a till signs out (warning 5 minutes before).
VITE_IDLE_TIMEOUT_MINUTES=30

# Where `npm run dev` proxies /api and /socket.io.
VITE_DEV_API_TARGET=http://localhost:3000
